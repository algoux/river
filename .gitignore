# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock IS tracked: this crate builds a cdylib (a Python extension), so
# the resolved dependency versions are part of the reproducible build.
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
.idea
.vscode
*.exe
.cargo
venv
dist/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

.dsh
.agent
.clude
